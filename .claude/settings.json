{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.langchain.com)",
      "WebFetch(domain:*.docs.langchain.com)",
      "WebFetch(domain:reference.langchain.com)",
      "WebFetch(domain:langfuse.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [],
    "deny": [
      "Read(/.prompts/**)",
      "Edit(/.prompts/**)"
    ]
  }
}
